#!/bin/sh
# Preview filter for less (LESSOPEN) and fzf-tab.
has() { command -v "$1" >/dev/null 2>&1; }

if [ -d "$1" ]; then
	eza --git -hl --color=always --icons=always -- "$1"
	exit
fi

case "$(file -bL --mime-type "$1")" in
image/*) has chafa && chafa "$1" || file -bL "$1" ;;
application/pdf) pdftotext -layout "$1" - ;;
text/* | */json | */xml | */javascript | inode/x-empty) bat --color=always "$1" ;;
*) exit 1 ;; # let less handle it
esac
