# ==========================================
# Appearance
# ==========================================
font-family = "Iosevka Term"
font-size = 18

# Ghostty uses standard lowercase-hyphenated names for themes
theme = Catppuccin Mocha

# ==========================================
# Core Keybindings
# ==========================================
keybind = super+n=new_window
keybind = super+r=reload_config

# ==========================================
# Tmux-like Multiplexing (Leader: Ctrl+B — Ctrl+A is the tmux prefix)
# ==========================================
# Tab Management
keybind = ctrl+b>n=next_tab
keybind = ctrl+b>p=previous_tab

# Window Splits (S for horizontal, V for vertical)
keybind = ctrl+b>s=new_split:down
keybind = ctrl+b>v=new_split:right
keybind = ctrl+b>x=close_surface
keybind = ctrl+b>z=toggle_split_zoom

# Window Navigation
keybind = ctrl+b>h=goto_split:left
keybind = ctrl+b>j=goto_split:bottom
keybind = ctrl+b>k=goto_split:top
keybind = ctrl+b>l=goto_split:right
