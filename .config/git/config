[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[user]
	email = leoaparisi@gmail.com
	name = Leo Aparisi de Lannoy
[core]
	editor = nvim
	pager = delta
[interactive]
	diffFilter = delta --color-only
[diff]
	algorithm = histogram
	colorMoved = default
	tool = nvimdiff
[difftool]
	prompt = false
[merge]
	conflictStyle = zdiff3
	tool = nvimdiff
[mergetool]
	prompt = true
[mergetool "nvimdiff"]
	cmd = "nvim -d \"$LOCAL\" \"$REMOTE\" \"$MERGED\" -c 'wincmd w' -c 'wincmd J'"
[fetch]
	prune = true
[push]
	autoSetupRemote = true
[diff "org"]
	xfuncname = "^(\\*+ +.*)$"
[delta]
	dark = true
	line-numbers = true
	navigate = true
	hyperlinks = true
	syntax-theme = Catppuccin Mocha
